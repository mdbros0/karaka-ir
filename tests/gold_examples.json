{
  "version": "1.0",
  "description": "Gold-standard examples for Karaka-IR pipeline evaluation. Each example has a hand-labeled karaka frame and expected derived facts so individual stages can be evaluated separately from end-to-end accuracy.",
  "notes": "expected_answer is approximate — LLM output varies. Use it as a reference, not an exact match target. expected_frame and expected_derived are the structural ground truth. rule_gaps lists inference gaps the current rules.py does not cover.",
  "examples": [
    {
      "id": "ex001",
      "sentence": "Maya gave Ravi a book at the library.",
      "question": "Who owns the book now?",
      "expected_answer": "Ravi owns the book.",
      "tags": ["karta", "karma", "sampradana", "adhikarana", "transfer_rule"],
      "expected_frame": {
        "verb_root": "give",
        "tense": "past",
        "karta":       { "lemma": "Maya",    "entity_type": "person" },
        "karma":       { "lemma": "book",    "entity_type": "object" },
        "karana":      null,
        "sampradana":  { "lemma": "Ravi",    "entity_type": "person" },
        "apadana":     null,
        "adhikarana":  { "lemma": "library", "entity_type": "location" }
      },
      "expected_derived": [
        ["owns",           "Ravi",    "book"],
        ["agent_is_human", "Maya"],
        ["event_location", "library"]
      ],
      "rule_gaps": []
    },
    {
      "id": "ex002",
      "sentence": "Anna bought groceries from the market on Sunday.",
      "question": "Where did Anna get the groceries from?",
      "expected_answer": "Anna got the groceries from the market.",
      "tags": ["karta", "karma", "apadana", "adhikarana", "purchase_rule", "temporal_adhikarana"],
      "expected_frame": {
        "verb_root": "buy",
        "tense": "past",
        "karta":       { "lemma": "Anna",      "entity_type": "person" },
        "karma":       { "lemma": "grocery",   "entity_type": "object" },
        "karana":      null,
        "sampradana":  null,
        "apadana":     { "lemma": "market",    "entity_type": "location" },
        "adhikarana":  { "lemma": "Sunday",    "entity_type": "time" }
      },
      "expected_derived": [
        ["formerly_owned", "market",  "grocery"],
        ["agent_is_human", "Anna"],
        ["event_time",     "Sunday"],
        ["owns",           "Anna",    "grocery"]
      ],
      "rule_gaps": []
    },
